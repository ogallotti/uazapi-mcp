{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uazapi-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Para usar um domínio próprio: npx wrangler deploy --domain mcp.seudominio.com
  "vars": { "EXTRA_ALLOWED_HOSTS": "" }
}
